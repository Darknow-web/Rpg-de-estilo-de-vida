{
  "name": "life-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LIFE QUEST — RPG de la vida real. Misiones reales, prueba con foto, personaje que sube de nivel.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.server.json server.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs --alias:@=./src",
    "start": "node dist/server.cjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run --exclude tests/rules/**",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-life-quest \"vitest run tests/rules\"",
    "preview": "npm run build && npm start",
    "e2e": "node tests/e2e/smoke.mjs",
    "art": "node scripts/optimize-art.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "express": "^5.1.0",
    "firebase": "^12.9.0",
    "jose": "^6.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "firebase-tools": "^14.0.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
