# ─── Servidor (SECRETOS: solo en Cloud Run / variables de entorno, nunca en el cliente) ───
# AI Studio la configura sola al desplegar. En local, pega tu clave de https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo de Gemini; si falla, el servidor prueba los demás de la lista en server/ai/model.ts
GEMINI_MODEL=
# Debe coincidir con el projectId de Firebase (se usa para verificar los ID tokens). Si falta, se lee de firebase-applet-config.json
FIREBASE_PROJECT_ID=
# Web Push (par VAPID, opcional). Genera uno con: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Cloud Run la inyecta; en local el servidor usa 3000
PORT=

# ─── Cliente (públicas, se incrustan en el bundle; NO son secretos) ───
# Si están vacías, el cliente usa firebase-applet-config.json (lo genera AI Studio).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
# Google Calendar (gratis): Client ID OAuth web. Pasos en docs/DEPLOY.md → "Google Calendar (gratis)".
VITE_GOOGLE_CLIENT_ID=
# Clave pública VAPID para Web Push (opcional)
VITE_VAPID_PUBLIC_KEY=
